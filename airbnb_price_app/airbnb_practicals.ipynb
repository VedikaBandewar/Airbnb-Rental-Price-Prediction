        "---\n",
        "## Practical 4: Probability distributions and Central Limit Theorem\n",
        "\n",
        "**Objective:** Fit a normal curve to valid nightly prices and demonstrate the Central Limit Theorem using repeated sample means. The KS p-value shown is only descriptive because the normal parameters are estimated from the same data."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Valid prices: 5995 | Mean: 72.336 | Sample SD: 75.172\n",
            "KS statistic: 0.21302737961516993 | p-value: 3.155405330380374e-239\n"
          ]
        },
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 900x500 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        },
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 900x500 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "from scipy import stats\n",
        "\n",
        "if \"price\" not in clean_df.columns:\n",
        "    print(\"No price column; skip price-distribution analysis until target column is configured.\")\n",
        "else:\n",
        "    values = clean_price(clean_df[\"price\"]).dropna().to_numpy(dtype=float)\n",
        "    values = values[np.isfinite(values) & (values > 0)]\n",
        "    if len(values) >= 2:\n",
        "        mu = float(values.mean())\n",
        "        sd = float(values.std(ddof=1))\n",
        "        print(f\"Valid prices: {len(values)} | Mean: {mu:.3f} | Sample SD: {sd:.3f}\")\n",
        "        plt.figure(figsize=(9, 5))\n",
        "        plt.hist(values, bins=40, density=True, alpha=0.65, label=\"Observed prices\")\n",
        "        if sd > 0:\n",
        "            grid = np.linspace(values.min(), values.max(), 300)\n",
        "            plt.plot(grid, stats.norm.pdf(grid, loc=mu, scale=sd), label=\"Fitted normal curve\")\n",
        "            ks = stats.kstest(values, lambda v: stats.norm.cdf(v, loc=mu, scale=sd))\n",
        "            print(\"KS statistic:\", ks.statistic, \"| p-value:\", ks.pvalue)\n",
        "        plt.legend()\n",
        "        plt.title(\"Price Distribution\")\n",
        "        plt.show()\n",
        "\n",
        "        rng = np.random.default_rng(42)\n",
        "        sample_size = min(30, len(values))\n",
        "        sample_means = [rng.choice(values, size=sample_size, replace=True).mean() for _ in range(1000)]\n",
        "        plt.figure(figsize=(9, 5))\n",
        "        plt.hist(sample_means, bins=35)\n",
        "        plt.title(f\"CLT: Distribution of 1,000 Sample Means (n={sample_size})\")\n",
        "        plt.xlabel(\"Sample mean price\")\n",
        "        plt.show()\n",
        "    else:\n",
        "        print(\"Not enough valid price values.\")"
      ]
    },
